{
  "name": "deepfriend",
  "displayName": "DeepFriend",
  "description": "%ext.description%",
  "version": "0.1.0",
  "publisher": "mrpark10",
  "license": "MIT",
  "engines": { "vscode": "^1.93.0" },
  "categories": ["Machine Learning", "Education", "Linters", "Visualization"],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onNotebook:jupyter-notebook",
    "workspaceContains:.deepfriend"
  ],
  "contributes": {},
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "build": "npm run copy-assets && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test:unit": "vitest run",
    "pretest:int": "npm run build && tsc -p tsconfig.test.json",
    "test:int": "vscode-test",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.93.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "ovsx": "^1.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@vscode/python-extension": "^1.0.6",
    "uplot": "^1.6.32"
  }
}
