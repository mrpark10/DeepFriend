{
  "name": "deepfriend",
  "displayName": "DeepFriend",
  "description": "%ext.description%",
  "version": "0.1.0",
  "publisher": "mrpark10",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Machine Learning",
    "Education",
    "Linters",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onNotebook:jupyter-notebook",
    "workspaceContains:.deepfriend"
  ],
  "contributes": {
    "commands": [
      {
        "command": "deepfriend.restartServer",
        "title": "%cmd.restartServer%",
        "category": "DeepFriend"
      },
      {
        "command": "deepfriend.selectPython",
        "title": "%cmd.selectPython%",
        "category": "DeepFriend"
      },
      {
        "command": "deepfriend.showStatus",
        "title": "%cmd.showStatus%",
        "category": "DeepFriend"
      },
      {
        "command": "deepfriend.reportIssue",
        "title": "%cmd.reportIssue%",
        "category": "DeepFriend"
      },
      {
        "command": "deepfriend.openDoctor",
        "title": "%cmd.openDoctor%",
        "category": "DeepFriend"
      },
      {
        "command": "deepfriend.setApiKey",
        "title": "%cmd.setApiKey%",
        "category": "DeepFriend"
      },
      {
        "command": "deepfriend.openModelView",
        "title": "%cmd.openModelView%",
        "category": "DeepFriend"
      }
    ],
    "configuration": {
      "title": "DeepFriend",
      "properties": {
        "deepfriend.language": {
          "type": "string",
          "enum": [
            "ko",
            "en"
          ],
          "enumDescriptions": [
            "%cfg.language.ko%",
            "%cfg.language.en%"
          ],
          "default": "ko",
          "description": "%cfg.language%",
          "order": 0
        },
        "deepfriend.level": {
          "type": "string",
          "enum": [
            "beginner",
            "normal"
          ],
          "enumDescriptions": [
            "%cfg.level.beginner%",
            "%cfg.level.normal%"
          ],
          "default": "beginner",
          "description": "%cfg.level%",
          "order": 1
        },
        "deepfriend.autoRecord": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoRecord%",
          "order": 2
        },
        "deepfriend.ai.provider": {
          "type": "string",
          "enum": [
            "off",
            "vscode",
            "anthropic",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "%cfg.ai.provider.off%",
            "%cfg.ai.provider.vscode%",
            "%cfg.ai.provider.anthropic%",
            "%cfg.ai.provider.openai%"
          ],
          "default": "vscode",
          "description": "%cfg.ai.provider%",
          "order": 3
        },
        "deepfriend.ai.consent": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%cfg.ai.consent.ask%",
            "%cfg.ai.consent.always%",
            "%cfg.ai.consent.never%"
          ],
          "default": "ask",
          "description": "%cfg.ai.consent%",
          "order": 4
        },
        "deepfriend.ai.anthropicModel": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "%cfg.ai.anthropicModel%",
          "order": 5
        },
        "deepfriend.ai.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "%cfg.ai.openaiBaseUrl%",
          "order": 6
        },
        "deepfriend.ai.openaiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "%cfg.ai.openaiModel%",
          "order": 7
        },
        "deepfriend.shapeHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.shapeHints%",
          "order": 8
        },
        "deepfriend.runtimeCheck": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.runtimeCheck%",
          "order": 9
        },
        "deepfriend.pythonPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.pythonPath%",
          "scope": "machine-overridable",
          "order": 10
        },
        "deepfriend.errorReporting.prompt": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.errorReporting%",
          "order": 11
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "deepfriend",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "%task.description%"
          }
        }
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "deepfriendPanel",
          "title": "%view.doctorContainer%",
          "icon": "media/deepfriend.svg"
        }
      ],
      "activitybar": [
        {
          "id": "deepfriend",
          "title": "DeepFriend",
          "icon": "media/deepfriend.svg"
        }
      ]
    },
    "views": {
      "deepfriendPanel": [
        {
          "type": "webview",
          "id": "deepfriend.doctor",
          "name": "%view.doctor%"
        }
      ],
      "deepfriend": [
        {
          "type": "webview",
          "id": "deepfriend.model",
          "name": "%view.model%"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "deepfriend.openDoctor",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "build": "npm run copy-assets && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test:unit": "vitest run",
    "pretest:int": "npm run build && tsc -p tsconfig.test.json",
    "test:int": "vscode-test",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.93.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "ovsx": "^1.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@vscode/python-extension": "^1.0.6",
    "uplot": "^1.6.32"
  }
}
